---
import "../styles/global.css";
import Preloader from "../components/preloader/Preloader.astro";
import SiteHeader from "../components/header/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HunterPark — Film, Photography & Design Studio",
  description = "HunterPark is a creative production studio for film, video, photography, design and visual storytelling.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <!-- Söhne Breit faces used above the fold (400 text, 500 UI, 700 titles) -->
    <link rel="preload" href="/fonts/soehne-breit-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/soehne-breit-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/soehne-breit-700.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Runs before first paint: flags JS, and skips the preloader on repeat views this session. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        // Add ?preloader to the URL to force it to play again while reviewing.
        var force = new URLSearchParams(location.search).has("preloader");
        if (!force && sessionStorage.getItem("hp:preloaded")) document.documentElement.classList.add("skip-preloader");
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Preloader />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
  </body>
</html>

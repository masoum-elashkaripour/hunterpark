---
/**
 * Site header — transparent over media, the wordmark does the talking.
 * Menu trigger (left) · centred wordmark · Contact Us CTA (right), at every size.
 * The trigger expands a short editorial list directly beneath it — Works, About,
 * News and the social icons. Menu entries don't route anywhere yet.
 * The wordmark is where the preloader's logo lands.
 * Hides on scroll down, returns on scroll up.
 */
import { primaryNav, socialLinks } from "../../data/navigation";
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" data-header-logo>
      <img src="/brand/logo.svg" alt="HunterPark — home" width="1096" height="179" decoding="async" />
    </a>


    <!-- Desktop CTA: a lime-ruled ticket; lime floods in from the left on hover -->
    <a href="/contact/" class="header-cta" data-header-cta>
      <span class="header-cta__label">
        <span class="header-cta__roll" data-text="Contact Us"><span>Contact Us</span></span>
      </span>
      <span class="header-cta__arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 12L12 4M5.5 4H12v6.5" />
        </svg>
      </span>
    </a>

    <!-- Menu trigger: expands the list below it -->
    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="menu-toggle__label" aria-hidden="true">
        <span class="menu-toggle__word">Menu</span>
        <span class="menu-toggle__word">Close</span>
      </span>
      <span class="visually-hidden" data-menu-toggle-sr>Open menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>

    <!-- Expanded menu: hangs from the trigger, left-aligned, off a lime rule -->
    <div id="site-menu" class="menu-panel" data-menu inert>
      <span class="menu-panel__rule" aria-hidden="true" data-menu-rule></span>
      <ul class="menu-panel__list" aria-label="Menu">
        {
          primaryNav.map((item) => (
            <li class="menu-panel__row">
              <button type="button" class="menu-panel__item" data-menu-item>
                <span class="menu-panel__dash" aria-hidden="true" />
                <span class="menu-panel__roll" data-text={item.label}>
                  <span>{item.label}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <ul class="menu-panel__social" aria-label="Social">
        {
          socialLinks.map((link) => (
            <li data-menu-social>
              <a href={link.href} class="menu-panel__icon" target="_blank" rel="noopener noreferrer">
                <span class="visually-hidden">{link.label} (opens in a new tab)</span>
                {link.label === "Instagram" ? (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3.5a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 13.4c0-3.1-1.65-5.15-4.4-5.15-1.6 0-2.62.86-3.05 1.62V8.5H9.72c.04.9 0 11.5 0 11.5h3.27v-6.42c0-1.62.72-2.72 2.1-2.72 1.3 0 1.98.9 1.98 2.72V20h3.37v-6.6Z" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--hp-z-header);
    color: var(--hp-off-white);
    transition:
      transform 0.7s var(--hp-ease-out),
      background-color 0.5s var(--hp-ease-out);
  }

  /* Compact state once the page moves — a solid strip, no blur, no gradient */
  .site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--hp-soft) 92%, transparent);
    box-shadow: 0 1px 0 var(--hp-dark);
  }

  .site-header.is-hidden {
    transform: translateY(-101%);
  }

  .site-header.is-menu-open {
    background-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .site-header__inner {
    position: relative; /* anchors the expanded menu */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--hp-header-h);
    padding-inline: var(--hp-gutter);
  }

  /* DOM order stays logo → CTA → toggle (home link first); the grid places them */
  .site-header__inner > * {
    grid-row: 1;
  }

  .site-header__logo {
    grid-column: 2;
    justify-self: center;
    display: block;
    width: clamp(8.25rem, 6.25rem + 5.75vw, 11.5rem);
  }

  .site-header__logo img {
    width: 100%;
    height: auto;
  }

  /* --- Contact CTA ------------------------------------------------------- */
  .header-cta {
    grid-column: 3;
    justify-self: end;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: stretch;
    height: 2.75rem;
    overflow: hidden;
    border: 1px solid var(--hp-lime);
    color: var(--hp-off-white);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.45s var(--hp-ease-out);
  }

  /* Lime floods in from the left edge */
  .header-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hp-lime);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.6s var(--hp-ease-out);
  }

  .header-cta:hover,
  .header-cta:focus-visible {
    color: var(--hp-soft);
  }

  .header-cta:hover::before,
  .header-cta:focus-visible::before {
    clip-path: inset(0 0 0 0);
  }

  .header-cta:focus-visible {
    outline-color: var(--hp-off-white);
  }

  .header-cta__label {
    display: flex;
    align-items: center;
    padding-inline: 1.15rem 1.05rem;
  }

  /* Label rolls up to a fresh copy of itself */
  .header-cta__roll {
    position: relative;
    display: block;
    overflow: hidden;
    line-height: 1.2;
  }

  .header-cta__roll > span,
  .header-cta__roll::after {
    display: block;
    transition: transform 0.55s var(--hp-ease-out);
  }

  .header-cta__roll::after {
    content: attr(data-text);
    position: absolute;
    inset: 100% 0 auto;
  }

  .header-cta:hover .header-cta__roll > span,
  .header-cta:hover .header-cta__roll::after,
  .header-cta:focus-visible .header-cta__roll > span,
  .header-cta:focus-visible .header-cta__roll::after {
    transform: translateY(-100%);
  }

  /* Arrow cell, split off by a lime rule; the ↗ swings round to → on hover */
  .header-cta__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    border-left: 1px solid var(--hp-lime);
    color: var(--hp-lime);
    transition:
      color 0.45s var(--hp-ease-out),
      border-color 0.45s var(--hp-ease-out);
  }

  .header-cta__arrow svg {
    transition: transform 0.6s var(--hp-ease-out);
  }

  .header-cta:hover .header-cta__arrow,
  .header-cta:focus-visible .header-cta__arrow {
    color: var(--hp-soft);
    border-color: var(--hp-soft);
  }

  .header-cta:hover .header-cta__arrow svg,
  .header-cta:focus-visible .header-cta__arrow svg {
    transform: rotate(45deg);
  }

  /* --- Menu trigger (left) ---------------------------------------------- */
  .menu-toggle {
    grid-column: 1;
    justify-self: start;
    flex-direction: row-reverse; /* icon leads on the left edge */
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem; /* touch target */
    font-size: var(--hp-text-body);
    font-weight: 500;
  }

  .menu-toggle__label {
    display: grid;
    overflow: hidden;
    line-height: 1.2;
  }

  .menu-toggle__word {
    grid-area: 1 / 1;
    transition: transform 0.6s var(--hp-ease-out);
  }

  .menu-toggle__word:last-child {
    transform: translateY(100%);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__word:first-child {
    transform: translateY(-100%);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__word:last-child {
    transform: none;
  }

  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.75rem;
    height: 0.625rem;
  }

  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--hp-lime);
    transition: transform 0.6s var(--hp-ease-out);
  }

  .menu-toggle__icon span:first-child { top: 0; }
  .menu-toggle__icon span:last-child { bottom: 0; transform-origin: left center; transform: scaleX(0.6); }

  .menu-toggle:hover .menu-toggle__icon span:last-child {
    transform: scaleX(1);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__icon span:first-child {
    transform: translateY(4px) rotate(35deg) scaleX(0.75);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__icon span:last-child {
    transform-origin: center;
    transform: translateY(-4px) rotate(-35deg) scaleX(0.75);
  }

  /* --- Expanded menu ------------------------------------------------------ */
  .menu-panel {
    position: absolute;
    top: calc(var(--hp-header-h) - 0.25rem);
    left: var(--hp-gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3svh, 2.25rem);
    padding: 0.5rem 0 0.5rem clamp(1.1rem, 1.6vw, 1.5rem);
    visibility: hidden;
  }

  /* A lime rule drops from the trigger and carries the list */
  .menu-panel__rule {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hp-lime);
    transform-origin: top center;
    transform: scaleY(0);
  }

  .menu-panel__list {
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 0.7svh, 0.5rem);
  }

  .menu-panel__item {
    display: flex;
    align-items: center;
    font-size: clamp(1.125rem, 0.95rem + 0.55vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: left;
  }

  /* A short lime dash slides in ahead of the hovered item */
  .menu-panel__dash {
    display: block;
    width: 0;
    height: 2px;
    margin-right: 0;
    background: var(--hp-lime);
    transition:
      width 0.5s var(--hp-ease-out),
      margin-right 0.5s var(--hp-ease-out);
  }

  .menu-panel__item:hover .menu-panel__dash,
  .menu-panel__item:focus-visible .menu-panel__dash {
    width: 0.75em;
    margin-right: 0.3em;
  }

  /* Label rolls up to a lime copy of itself */
  .menu-panel__roll {
    position: relative;
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .menu-panel__roll > span,
  .menu-panel__roll::after {
    display: block;
    transition: transform 0.55s var(--hp-ease-out);
  }

  .menu-panel__roll::after {
    content: attr(data-text);
    position: absolute;
    inset: 100% 0 auto;
    color: var(--hp-lime);
  }

  .menu-panel__item:hover .menu-panel__roll > span,
  .menu-panel__item:hover .menu-panel__roll::after,
  .menu-panel__item:focus-visible .menu-panel__roll > span,
  .menu-panel__item:focus-visible .menu-panel__roll::after {
    transform: translateY(-100%);
  }

  .menu-panel__social {
    display: flex;
    gap: 0.5rem;
  }

  /* Square, sharp icon cells — same lime-ruled language as the Contact CTA */
  .menu-panel__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--hp-off-white) 35%, transparent);
    color: var(--hp-off-white);
    transition:
      color 0.35s var(--hp-ease-out),
      border-color 0.35s var(--hp-ease-out),
      background-color 0.35s var(--hp-ease-out);
  }

  .menu-panel__icon:hover,
  .menu-panel__icon:focus-visible {
    border-color: var(--hp-lime);
    background-color: var(--hp-lime);
    color: var(--hp-soft);
  }

  /* Before the preloader hands off, intro elements wait off-stage (JS only) */
  :global(html.js:not([data-site-ready])) .site-header__logo,
  :global(html.js:not([data-site-ready])) .header-cta,
  :global(html.js:not([data-site-ready])) .menu-toggle {
    opacity: 0;
  }

  /* Phones: the CTA folds down to its arrow cell so it clears the centred logo
     (the label stays in the accessibility tree) */
  @media (max-width: 599px) {
    .header-cta__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .header-cta__arrow {
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu-toggle__word,
    .menu-toggle__icon span,
    .header-cta,
    .header-cta::before,
    .header-cta__roll > span,
    .header-cta__roll::after,
    .header-cta__arrow,
    .header-cta__arrow svg,
    .menu-panel__dash,
    .menu-panel__roll > span,
    .menu-panel__roll::after,
    .menu-panel__icon {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  import { initHeader } from "../../scripts/header";
  initHeader();
</script>

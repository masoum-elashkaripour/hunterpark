---
/**
 * Hero — a living contact sheet.
 * The full-bleed background cycles through the stills; the same stills sit in a
 * small row at the foot of the frame, with the active one ringed in lime.
 * Every thumbnail is a landscape frame, cropped with object-fit: cover.
 * A slide can be a film: it plays muted as the background while active, and the
 * sequence waits for it to finish (see scripts/hero.ts for the timing rules).
 */
import { Image, getImage } from "astro:assets";
import { heroSlides, HERO_INTERVAL_MS } from "../../data/media";

// Poster frames for film slides — shown until the first video frame is ready.
const posters = await Promise.all(
  heroSlides.map((slide) =>
    slide.video ? getImage({ src: slide.src, width: 1920, format: "webp", quality: 70 }).then((img) => img.src) : null,
  ),
);
---

<section class="hero" aria-labelledby="hero-title" data-hero data-interval={HERO_INTERVAL_MS}>
  <div class="hero__backdrop" aria-hidden="true">
    {
      heroSlides.map((slide, i) =>
        slide.video ? (
          <video
            class:list={["hero__bg", { "is-active": i === 0 }]}
            style={`object-position: ${slide.focus}`}
            data-hero-bg={i}
            poster={posters[i]!}
            muted
            loop
            playsinline
            autoplay={i === 0}
            preload={i === 0 ? "auto" : "none"}
            disablepictureinpicture
          >
            <source src={slide.video.sd} type="video/mp4" media="(max-width: 767px)" />
            <source src={slide.video.sdWebm} type="video/webm" media="(max-width: 767px)" />
            <source src={slide.video.hd} type="video/mp4" />
            <source src={slide.video.hdWebm} type="video/webm" />
          </video>
        ) : (
        <Image
          src={slide.src}
          alt=""
          width={1920}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          format="webp"
          quality={75}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
          class:list={["hero__bg", { "is-active": i === 0 }]}
          style={`object-position: ${slide.focus}`}
          data-hero-bg={i}
        />
        ),
      )
    }
  </div>

  <div class="hero__content">
    <!-- Two scales: whispered lead-ins, shouted keywords. Reads as one sentence to assistive tech. -->
    <h1 class="hero__title" id="hero-title" data-hero-tilt>
      <span class="hero__row hero__row--1">
        <span class="hero__mask hero__small"><span data-hero-reveal>We do not</span></span>
        <span class="hero__mask hero__big"><span data-hero-reveal>hunt,</span></span>
      </span>
      <span class="hero__row hero__row--2">
        <span class="hero__mask hero__small"><span data-hero-reveal>we aren<span class="hero__apos">’</span>t the</span></span>
        <span class="hero__mask hero__big"><span data-hero-reveal>park.</span></span>
      </span>
    </h1>

    <div class="hero__reel" style={`--count: ${heroSlides.length}`}>
      <!-- Caption for the photographs below -->
      <div class="hero__reel-head" data-hero-fade>
        <p class="hero__caption">Newest Project</p>
        <!-- Editorial folio: the current number leads, the total whispers -->
        <p class="hero__counter" aria-hidden="true">
          <span class="hero__counter-now"><span data-hero-count>01</span></span>
          <span class="hero__counter-total"><span class="hero__counter-slash">/</span>{String(heroSlides.length).padStart(2, "0")}</span>
        </p>
      </div>

      <!-- Project strip: the active project opens wide, the rest fold into slivers -->
      <ul class="hero__thumbs" aria-label="Projects">
        {
          heroSlides.map((slide, i) => (
            <li class="hero__thumb-item" data-hero-thumb-item>
              <button
                type="button"
                class:list={["hero__thumb", { "is-active": i === 0 }]}
                aria-label={`Show ${slide.video ? "film" : "still"} ${i + 1} of ${heroSlides.length}`}
                aria-current={i === 0 ? "true" : undefined}
                data-hero-thumb={i}
              >
                <Image
                  src={slide.src}
                  alt=""
                  width={480}
                  widths={[240, 480]}
                  sizes="(max-width: 767px) 180px, 240px"
                  format="webp"
                  quality={70}
                  loading="eager"
                  style={`object-position: ${slide.focus}`}
                />
                {slide.video && (
                  <span class="hero__film" aria-hidden="true">
                    <svg viewBox="0 0 10 12" width="8" height="10"><path d="M0 0l10 6-10 6z" fill="currentColor" /></svg>
                  </span>
                )}
                <span class="hero__progress" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ul>

      <!-- View Project: kin to the Contact CTA (hairline rules, rolling label, arrow cell)
           but its own shape. No destination yet — project pages don't exist. -->
      <button type="button" class="view-project" data-view-project data-hero-fade>
        <span class="view-project__roll" data-text="View Project"><span>View Project</span></span>
        <span class="view-project__line" aria-hidden="true"></span>
        <span class="view-project__arrow" aria-hidden="true" data-view-arrow>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 12L12 4M5.5 4H12v6.5" />
          </svg>
        </span>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Project strip geometry: one open card (2:1) + folded slivers, fixed total width */
    --reel-h: clamp(5rem, min(3.4rem + 3.6vw, 12svh), 8.25rem); /* width- and height-aware so short screens keep clear of the title */
    --card-w: calc(var(--reel-h) * 2);
    --sliver: calc(var(--reel-h) * 0.36);
    --peek: calc(var(--reel-h) * 0.62);
    --reel-gap: 6px;

    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  /* --- Background --------------------------------------------------------- */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hp-night);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 1.1s var(--hp-ease-in-out),
      transform 3.2s var(--hp-ease-out);
  }

  .hero__bg.is-active {
    z-index: 1;
    opacity: 1;
    transform: scale(1);
  }

  /* The outgoing still stays put underneath while the new one fades over it */
  .hero__bg.is-leaving {
    opacity: 1;
    transform: scale(1);
    transition: none;
  }

  /* Image → 50% black → text & UI. Sits above every slide, so it holds through transitions. */
  .hero__backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--hp-hero-overlay);
  }

  /* --- Foreground --------------------------------------------------------- */
  .hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    padding: calc(var(--hp-header-h) + 2rem) var(--hp-gutter) var(--hp-gutter);
  }

  /* Caption for the photo row — the design system's label style (Söhne Leicht, caps, lime) */
  .hero__caption {
    font-family: var(--hp-font-primary);
    font-weight: 300;
    font-size: clamp(0.75rem, 0.65rem + 0.3vw, 0.9375rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-lime);
  }

  .hero__caption::before {
    content: "";
    display: inline-block;
    width: 2.5em;
    height: 1px;
    margin-right: 0.9em;
    vertical-align: 0.3em;
    background: currentColor;
  }

  /* --- Title: editorial scale contrast ---------------------------------------
   * Keywords in Söhne Breit Extrafett, oversized and lime; lead-ins in Leicht Kursiv,
   * small and tucked against them. Row 1 hangs its lead-in from the cap line, row 2
   * sits it on the baseline, and row 2 steps right — a diagonal read, not a stack.
   * Centred in the hero, independent of the reel below. */
  .hero__title {
    --big: clamp(3.4rem, min(13.5vw, 21svh), 14.5rem);
    --small: max(0.8125rem, calc(var(--big) * 0.135));

    /* Centred with inset + auto margins (not translate) so the tilt can own `transform` */
    position: absolute;
    inset: 0;
    width: fit-content;
    height: fit-content;
    margin: auto;
    display: flex;
    flex-direction: column;
    font-family: var(--hp-font-primary);
    white-space: nowrap;
    transform-style: preserve-3d; /* lets the lead-ins sit on their own depth plane when tilted */
  }

  .hero__row {
    transform-style: preserve-3d;
    display: flex;
    gap: calc(var(--big) * 0.12);
  }

  .hero__row--1 {
    align-items: flex-start;
  }

  .hero__row--2 {
    align-items: baseline;
    margin-top: calc(var(--big) * -0.02);
    padding-left: calc(var(--big) * 1.15);
  }

  .hero__mask {
    display: block;
    overflow: hidden;
  }

  .hero__mask > span {
    display: block;
  }

  /* Lead-ins: Söhne Breit Buch — the cut the files name "Test Söhne Breit" */
  .hero__small {
    font-size: var(--small);
    font-weight: 400;
    font-style: normal;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--hp-off-white);
    transform: translateZ(calc(var(--big) * 0.15)); /* shallow depth plane: parallax under tilt, ~2% at rest */
  }

  /* The trial Söhne cut has no apostrophe; the fallback glyph needs pulling into the word */
  .hero__apos {
    margin-inline: -0.03em -0.01em;
  }

  /* Hang the first lead-in off the keyword's cap height */
  .hero__row--1 .hero__small {
    padding-top: calc(var(--big) * 0.1);
  }

  .hero__big {
    font-size: var(--big);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--hp-lime);
    padding-bottom: 0.04em; /* room for the comma's tail inside the reveal mask */
  }

  .hero__reel {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.875rem;
  }

  .hero__reel-head {
    align-self: stretch; /* spans the thumbnail row: caption left, counter right */
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  /* Folio: large light numeral in Söhne Breit, total tucked top-right in Instrument Sans,
     one lime stroke between them */
  .hero__counter {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    line-height: 1;
  }

  .hero__counter-now {
    display: block;
    overflow: hidden; /* mask for the number roll */
    font-family: var(--hp-font-primary);
    font-weight: 300;
    font-size: clamp(1.75rem, 1.1rem + 1.3vw, 2.625rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--hp-off-white);
  }

  .hero__counter-now > span {
    display: block;
  }

  .hero__counter-total {
    font-family: var(--hp-font-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--hp-gray);
  }

  .hero__counter-slash {
    margin-right: 0.3em;
    color: var(--hp-lime);
  }

  /* Fixed-width strip: the open card takes whatever the slivers leave, so hovering
     a sliver open borrows from the card and nothing around the strip shifts */
  .hero__thumbs {
    display: flex;
    gap: var(--reel-gap);
    width: calc(var(--card-w) + (var(--count) - 1) * (var(--sliver) + var(--reel-gap)));
  }

  .hero__thumb-item {
    flex: 0 0 var(--sliver);
    min-width: 0;
    transition:
      flex-grow 0.8s var(--hp-ease-out),
      flex-basis 0.8s var(--hp-ease-out);
  }

  .hero__thumb-item:has(.is-active) {
    flex: 1 1 0;
  }

  .hero__thumb-item:not(:has(.is-active)):hover {
    flex-basis: var(--peek);
  }

  .hero__thumb {
    position: relative;
    display: block;
    width: 100%;
    height: var(--reel-h);
    overflow: hidden;
    border-radius: 0; /* default: sharp, like the type */
    transition: border-radius 0.5s var(--hp-ease-out);
  }

  /* Selected: rounded + lime border — the design system's sample-row treatment */
  .hero__thumb.is-active {
    border-radius: 0.5rem;
  }

  /* Border drawn above the image so the still can't paint over it */
  .hero__thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 3px solid transparent;
    border-radius: inherit;
    pointer-events: none;
    transition: border-color 0.4s var(--hp-ease-out);
  }

  .hero__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transform: scale(1.04);
    transition:
      opacity 0.5s var(--hp-ease-out),
      transform 0.8s var(--hp-ease-out);
  }

  .hero__thumb:hover img,
  .hero__thumb:focus-visible img {
    opacity: 1;
    transform: scale(1);
  }

  /* Marks the film thumbnail */
  .hero__film {
    position: absolute;
    left: 0.4rem;
    bottom: 0.45rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--hp-lime);
    color: var(--hp-soft);
    padding-left: 1px;
  }

  /* Active still — lime border, per the design system's sample row */
  .hero__thumb.is-active::after {
    border-color: var(--hp-lime);
  }

  .hero__thumb.is-active img {
    opacity: 1;
    transform: scale(1);
  }

  /* Timer: a lime hairline fills across the active thumbnail — driven by hero.ts
     (the still interval, or a film's playback position) */
  .hero__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 3px;
    background: var(--hp-lime);
    transform-origin: left center;
    transform: scaleX(0);
  }


  /* --- View Project -------------------------------------------------------- */
  .view-project {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    height: 2.5rem;
    margin-top: 0.25rem;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-off-white);
  }

  .view-project:focus-visible {
    outline-offset: 6px;
  }

  /* Label rolls up to a lime copy */
  .view-project__roll {
    position: relative;
    display: block;
    overflow: hidden;
    line-height: 1.2;
    white-space: nowrap;
  }

  .view-project__roll > span,
  .view-project__roll::after {
    display: block;
    transition: transform 0.55s var(--hp-ease-out);
  }

  .view-project__roll::after {
    content: attr(data-text);
    position: absolute;
    inset: 100% 0 auto;
    color: var(--hp-lime);
  }

  /* Hairline that draws out across the strip */
  .view-project__line {
    flex: 1;
    height: 1px;
    background: var(--hp-lime);
    transform-origin: left center;
    transform: scaleX(0.22);
    transition: transform 0.9s var(--hp-ease-out);
  }

  /* Arrow cell — floods lime from the bottom (the Contact CTA sweeps from the left) */
  .view-project__arrow {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border: 1px solid var(--hp-lime);
    color: var(--hp-lime);
    transition: color 0.45s var(--hp-ease-out);
  }

  .view-project__arrow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hp-lime);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.55s var(--hp-ease-out);
  }

  .view-project__arrow svg {
    transition: transform 0.6s var(--hp-ease-out);
  }

  /* Hover — on the bar itself, or on the open project card above it */
  .view-project:hover .view-project__roll > span,
  .view-project:hover .view-project__roll::after,
  .view-project:focus-visible .view-project__roll > span,
  .view-project:focus-visible .view-project__roll::after,
  .hero__reel:has(.hero__thumb.is-active:hover) .view-project__roll > span,
  .hero__reel:has(.hero__thumb.is-active:hover) .view-project__roll::after {
    transform: translateY(-100%);
  }

  .view-project:hover .view-project__line,
  .view-project:focus-visible .view-project__line,
  .hero__reel:has(.hero__thumb.is-active:hover) .view-project__line {
    transform: scaleX(1);
  }

  .view-project:hover .view-project__arrow,
  .view-project:focus-visible .view-project__arrow,
  .hero__reel:has(.hero__thumb.is-active:hover) .view-project__arrow {
    color: var(--hp-soft);
  }

  .view-project:hover .view-project__arrow::before,
  .view-project:focus-visible .view-project__arrow::before,
  .hero__reel:has(.hero__thumb.is-active:hover) .view-project__arrow::before {
    clip-path: inset(0 0 0 0);
  }

  .view-project:hover .view-project__arrow svg,
  .view-project:focus-visible .view-project__arrow svg,
  .hero__reel:has(.hero__thumb.is-active:hover) .view-project__arrow svg {
    transform: rotate(45deg);
  }

  /* Before the preloader hands off, text + reel wait off-stage (JS only) */
  :global(html.js:not([data-site-ready])) .hero__mask > span {
    transform: translateY(110%);
  }

  :global(html.js:not([data-site-ready])) .hero__thumb-item,
  :global(html.js:not([data-site-ready])) .hero__reel-head,
  :global(html.js:not([data-site-ready])) .view-project {
    opacity: 0;
  }

  /* Tablet and below: the reel moves to the left edge */
  @media (max-width: 1023px) {
    .hero__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .hero__reel {
      grid-column: 1;
      align-items: flex-start;
      justify-self: start; /* caption row stays as wide as the photos, not the page */
    }
  }

  @media (max-width: 767px) {
    .hero {
      --reel-h: 6rem;
      --card-w: calc(var(--reel-h) * 1.7);
      --sliver: calc(var(--reel-h) * 0.3);
      --peek: calc(var(--reel-h) * 0.5);
    }

    .hero__title {
      bottom: 8%; /* centres at 46%: the optical middle of the space above the reel */
    }

    .hero__row--2 {
      padding-left: calc(var(--big) * 0.55);
    }

    .hero__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg,
    .hero__thumb,
    .hero__thumb img,
    .hero__thumb-item,
    .view-project__roll > span,
    .view-project__roll::after,
    .view-project__line,
    .view-project__arrow,
    .view-project__arrow::before,
    .view-project__arrow svg {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { initHero } from "../../scripts/hero";
  import { createTilt } from "../../scripts/tilt";
  import { prefersReducedMotion } from "../../scripts/lifecycle";

  initHero();

  // Mouse-driven depth on the title (desktop pointers only; off for reduced motion).
  const title = document.querySelector<HTMLElement>("[data-hero-tilt]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (title && hero) createTilt(title, { area: hero });

  // View Project: the arrow cell leans a few px toward the pointer while it's over the bar.
  const bar = document.querySelector<HTMLElement>("[data-view-project]");
  const arrow = document.querySelector<HTMLElement>("[data-view-arrow]");
  if (bar && arrow && !prefersReducedMotion() && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const toX = gsap.quickTo(arrow, "x", { duration: 0.6, ease: "power3.out" });
    const toY = gsap.quickTo(arrow, "y", { duration: 0.6, ease: "power3.out" });
    bar.addEventListener("pointermove", (e) => {
      const r = arrow.getBoundingClientRect();
      toX(gsap.utils.clamp(-6, 6, (e.clientX - (r.left + r.width / 2)) * 0.12));
      toY(gsap.utils.clamp(-4, 4, (e.clientY - (r.top + r.height / 2)) * 0.2));
    });
    bar.addEventListener("pointerleave", () => {
      toX(0);
      toY(0);
    });
  }
</script>

---
/**
 * Preloader — "the drop".
 * Photographs from the studio's archive are dropped one by one behind the
 * HunterPark wordmark as loading progresses. The last one to land is the
 * hero's own background image: at 100% it opens out to full bleed while the
 * wordmark flies up into the header, and the page is simply… there.
 */
import { Image } from "astro:assets";
import { collagePool } from "../../data/media";
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__stack" data-stack></div>

  <!-- The hero's first background <img> is moved in here at runtime (see hero-handoff.ts) -->
  <div class="preloader__final" data-final>
    <span class="preloader__shade" data-shade></span>
  </div>

  <img class="preloader__logo" src="/brand/logo.svg" alt="" width="1096" height="179" data-logo />

  <p class="preloader__count"><span data-count>00</span><span class="preloader__unit">%</span></p>

  <!-- Candidate photographs. Templates don't load; the script clones a random selection. -->
  <template data-cards>
    {
      collagePool.map((still) => (
        <Image
          src={still.src}
          alt=""
          width={560}
          widths={[280, 560]}
          sizes="(max-width: 767px) 34vw, 18vw"
          format="webp"
          quality={70}
          decoding="async"
          class="preloader__card"
          data-ratio={(still.src.width / still.src.height).toFixed(3)}
        />
      ))
    }
  </template>
</div>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--hp-z-preloader);
    background: var(--hp-night); /* Night Black — the design system's background */
    overflow: hidden;
  }

  /* Only shown when JS is running and this is the first view of the session. */
  :global(html.js:not(.skip-preloader)) .preloader {
    display: block;
  }

  .preloader__stack {
    position: absolute;
    inset: 0;
  }

  /* Cards are positioned from the viewport centre; JS sets size, offset and rotation */
  .preloader__stack :global(.preloader__card) {
    position: absolute;
    left: 50%;
    top: 50%;
    object-fit: cover;
    opacity: 0;
    box-shadow: 0 1.25rem 3rem rgb(0 0 0 / 0.45);
    will-change: transform, opacity;
  }

  /* A full-viewport frame, scaled down to card size — so opening it is a pure transform */
  .preloader__final {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-origin: 50% 50%;
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.55);
    will-change: transform;
  }

  /* Matches the hero's overlay exactly; fades in as the frame opens */
  .preloader__shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--hp-hero-overlay);
    opacity: 0;
  }

  .preloader__logo {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: clamp(17rem, 58vw, 62rem);
    height: auto;
    margin: 0;
    translate: -50% -50%; /* centring lives on `translate`, so GSAP owns `transform` freely */
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .preloader__count {
    position: absolute;
    right: var(--hp-gutter);
    bottom: calc(var(--hp-gutter) * 0.6);
    z-index: 2;
    font-family: var(--hp-font-primary);
    font-weight: 700;
    font-size: clamp(4rem, 2rem + 8vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--hp-off-white);
  }

  .preloader__unit {
    font-size: 0.38em;
    vertical-align: top;
    margin-left: 0.08em;
    color: var(--hp-lime);
  }

  @media (max-width: 767px) {
    .preloader__logo {
      width: 82vw;
    }
  }
</style>

<script>
  import { runPreloader } from "../../scripts/preloader";
  runPreloader();
</script>
